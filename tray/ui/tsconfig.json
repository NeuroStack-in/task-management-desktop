{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    /* Pinned so TS can't silently absorb @types from node_modules further up the tree
       (there is an unrelated node_modules in the user's home dir). Panel code is
       browser-only: no Node globals. */
    "types": ["vite/client"],
    /* No baseUrl: it's deprecated in TS 6 and removed in 7. Paths resolve relative
       to this file. The matching runtime alias lives in vite.config.ts. */
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src"]
}
